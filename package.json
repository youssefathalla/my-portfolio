{
  "name": "portfolio",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "dev": "ng serve",
    "prebuild": "tsx scripts/build-guards/run.ts && node scripts/generate-sitemap.mjs",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "lint": "eslint .",
    "assert-build": "node scripts/assert-build-output.mjs",
    "assert-no-any": "node scripts/assert-no-any.mjs",
    "test:emulator": "npm --prefix functions run test:emulator",
    "sync:agents": "node scripts/sync-agent-docs.mjs",
    "sync:agents:check": "node scripts/sync-agent-docs.mjs --check"
  },
  "private": true,
  "packageManager": "npm@11.17.0",
  "dependencies": {
    "@angular/cdk": "^22.1.4",
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/forms": "^22.1.0",
    "@angular/material": "^22.1.4",
    "@angular/platform-browser": "^22.1.0",
    "@angular/platform-server": "^22.1.0",
    "@angular/router": "^22.1.0",
    "@angular/ssr": "^22.1.0",
    "@tailwindcss/postcss": "^4.3.3",
    "express": "^5.2.1",
    "firebase": "11.6.0",
    "gsap": "^3.15.0",
    "postcss": "^8.5.26",
    "rxjs": "~7.8.0",
    "tailwindcss": "^4.3.3",
    "tslib": "^2.3.0",
    "valibot": "^1.4.2"
  },
  "devDependencies": {
    "@angular/build": "^22.1.3",
    "@angular/cli": "^22.1.3",
    "@angular/compiler-cli": "^22.1.0",
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/node": "^20.17.19",
    "angular-eslint": "^22.1.0",
    "eslint": "^10.9.1",
    "fast-check": "^4.9.0",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "tsx": "4.23.12",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.68.0",
    "vitest": "^4.0.8"
  },
  "allowScripts": {
    "@parcel/watcher@2.6.0": true,
    "esbuild@0.28.2": true,
    "lmdb@3.5.6": true,
    "msgpackr-extract@3.0.4": true,
    "protobufjs@7.6.6": true
  }
}
