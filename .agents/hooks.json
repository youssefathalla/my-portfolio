{
  "agent-docs-guard": {
    "PreToolUse": [
      {
        "matcher": "write_to_file|replace_file_content|multi_replace_file_content",
        "hooks": [
          {
            "type": "command",
            "command": "node ../scripts/hooks/antigravity-guard-agents-dir.mjs",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "agent-docs-sync": {
    "PostToolUse": [
      {
        "matcher": "write_to_file|replace_file_content|multi_replace_file_content",
        "hooks": [
          {
            "type": "command",
            "command": "node ../scripts/hooks/antigravity-sync-agents.mjs",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
